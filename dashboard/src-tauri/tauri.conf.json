{
  "$schema": "https://raw.githubusercontent.com/nicoritschel/tauri-app/master/tooling/cli/schema.json",
  "productName": "Runlight",
  "version": "0.1.0",
  "identifier": "mind.renaissance.runlight.dashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Runlight",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
